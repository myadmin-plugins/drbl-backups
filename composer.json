{
	"name": "detain/myadmin-drbl-backups",
	"type": "myadmin-plugin",
	"description": "DRBL (Diskless Remote Boot in Linux) backup handling plugin for the MyAdmin control panel, providing event-driven integration for backup service management.",
	"keywords": [
		"drbl",
		"backups",
		"myadmin",
		"plugin",
		"administration"
	],
	"license": "LGPL-2.1-only",
	"authors": [
		{
			"name": "Joe Huss",
			"homepage": "https://my.interserver.net/"
		}
	],
	"config": {
		"bin-dir": "vendor/bin",
		"minimum-stability": "dev"
	},
	"require": {
		"php": ">=7.4",
		"ext-soap": "*",
		"symfony/event-dispatcher": "^5.0||^6.0||^7.0",
		"detain/myadmin-plugin-installer": "dev-master"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"Detain\\MyAdminDrbl\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Detain\\MyAdminDrbl\\Tests\\": "tests/"
		}
	}
}
